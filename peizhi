}

CF_API_KEY="WwmHgslqyTtf-7efbfASsd0wfuo2FGb-EjrRNWDf"
ZONE_ID="b6fb85fc007fc746bb81879e696f4ef4"
DNS_RECORD_NAMES="usip23.333333338.xyz"
API="https://api.cloudflare.com/client/v4"

# 获取公网 IP
CURRENT_IP=$(wget -qO- --no-check-certificate https://api.ipify.org)
if [ -z "$CURRENT_IP" ]; then
    log "[ERROR] 获取公网 IP 失败"
    exit 1
fi
log "[OK] 当前公网 IP: $CURRENT_IP"

for DNS_RECORD_NAME in $DNS_RECORD_NAMES; do
    log "[INFO] 处理域名: $DNS_RECORD_NAME"

    # 查询旧记录
    RECORD=$(wget -qO- --no-check-certificate \
        --header="Authorization: Bearer $CF_API_KEY" \
        --header="Content-Type: application/json" \
        "$API/zones/$ZONE_ID/dns_records?type=A&name=$DNS_RECORD_NAME")

    RECORD_ID=$(echo "$RECORD" | grep -o '"id":"[^"]*' | cut -d'"' -f4)

    if [ -n "$RECORD_ID" ]; then
        log "[OK] 找到旧记录 ID=$RECORD_ID，删除..."
        wget -qO- --no-check-certificate \
            --method=DELETE \
            --header="Authorization: Bearer $CF_API_KEY" \
            --header="Content-Type: application/json" \
            "$API/zones/$ZONE_ID/dns_records/$RECORD_ID" >/dev/null
    else
        log "[INFO] 未找到旧记录"
    fi

    # 创建新的 A 记录
    log "[INFO] 创建新的 A 记录..."
    CREATE_RESULT=$(wget -qO- --no-check-certificate \
        --header="Authorization: Bearer $CF_API_KEY" \
        --header="Content-Type: application/json" \
        --post-data="{\"type\":\"A\",\"name\":\"$DNS_RECORD_NAME\",\"content\":\"$CURRENT_IP\",\"ttl\":120,\"proxied\":false}" \
        "$API/zones/$ZONE_ID/dns_records")

    log "[INFO] 创建返回: $CREATE_RESULT"

    if echo "$CREATE_RESULT" | grep -q '"success":true'; then
        log "[OK] 成功创建 A 记录 $DNS_RECORD_NAME -> $CURRENT_IP"
    else
        log "[ERROR] 创建 A 记录失败"
    fi
done
EOCF

