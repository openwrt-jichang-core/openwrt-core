wait_network() {
    log "[INFO] 等待网络可用..."
    TRIES=0
    MAX_TRIES=12
    while ! curl -s --head https://www.google.com >/dev/null 2>&1; do
        TRIES=$((TRIES+1))
        if [ $TRIES -ge $MAX_TRIES ]; then
            log "[ERROR] 网络长时间不可用，退出启动"
            exit 1
        fi
        log "[INFO] 网络未就绪，等待 5 秒..."
        sleep 5
    done
    log "[INFO] 网络已就绪"
}

