wait_network() {
    log "[INFO] Waiting for network availability..."
    TRIES=0
    MAX_TRIES=12
    while ! curl -s --head https://www.google.com >/dev/null 2>&1; do
        TRIES=$((TRIES+1))
        if [ $TRIES -ge $MAX_TRIES ]; then
            log "[ERROR] Network is unavailable for a long time, exiting startup"
            exit 1
        fi
        log "[INFO] Network is not ready, waiting for 5 seconds..."
        sleep 5
    done
    log "[INFO] Network is ready"
}

